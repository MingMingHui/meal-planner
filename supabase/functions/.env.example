# -----------------------------------------------------------------------------
# Edge Function secrets for ai-proxy — TEMPLATE ONLY, never put real values here
# -----------------------------------------------------------------------------
# For local `supabase functions serve`, copy to supabase/functions/.env
# (git-ignored). For production, set them as function secrets instead:
#   supabase secrets set AI_CREDENTIALS_ENCRYPTION_KEY="$(openssl rand -base64 32)"
#   supabase secrets set AI_PROXY_ALLOWED_ORIGINS="https://USERNAME.github.io,https://localhost"
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase automatically — do not set them here.
#
# There are NO AI provider keys here: each user connects their own provider
# account in the app (Settings → AI Provider).
# -----------------------------------------------------------------------------

# Required. Base64 of exactly 32 random bytes. Encrypts users' AI credentials
# at rest (AES-256-GCM). Losing or changing it makes saved credentials
# unreadable — users will be asked to reconnect.
AI_CREDENTIALS_ENCRYPTION_KEY=

# Optional. Comma-separated origins allowed to call ai-proxy from a browser.
# Default "*" (safe: requests are authorized by the user's bearer token, not
# cookies). Include https://localhost for the Android app.
AI_PROXY_ALLOWED_ORIGINS=
