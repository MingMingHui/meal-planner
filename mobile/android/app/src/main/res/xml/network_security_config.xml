<?xml version="1.0" encoding="utf-8"?>
<!--
  Release/production: HTTPS only, system CAs only. The app's own pages are
  served by Capacitor's in-process asset loader (https://localhost), which is
  not real network traffic and is unaffected by this file.
  Debug builds override this with src/debug/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
