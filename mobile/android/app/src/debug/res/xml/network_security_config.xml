<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Allows cleartext to local development hosts so
  "npx cap run android" with live reload from your machine, and a
  local Supabase (supabase start, http://10.0.2.2:54321 from the emulator)
  work. Release builds use src/main/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
