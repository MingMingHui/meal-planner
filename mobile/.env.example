# ----------------------------------------------------------------------------
# Mobile app environment configuration
# ----------------------------------------------------------------------------
# Copy to one file per environment (all are git-ignored):
#   mobile/.env.development   npm run build:web            (dev builds)
#   mobile/.env.staging       npm run build:web:staging
#   mobile/.env.production    npm run build:web:production (release AAB)
# Real environment variables with the same names override these files (CI).
#
# NOTHING in this file is a secret: everything here ships inside the app and
# can be read by anyone who downloads it. NEVER put a Supabase service_role /
# sb_secret_ key, an AI provider key, or signing passwords here — the build
# refuses service_role keys outright.
# ----------------------------------------------------------------------------

# Supabase project URL (Dashboard → Project Settings → API). Must be https://
# for staging/production. Leave both Supabase values unset in development to
# use the defaults already in js/config.js.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon / publishable key (sb_publishable_... or the legacy anon JWT).
# Public by design — access control is enforced by Row Level Security.
SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# AI providers: there is NOTHING to configure here. Users connect their own
# AI provider (OpenAI, Anthropic, OpenRouter, …) inside the app; keys saved to
# an account are encrypted by the ai-proxy Edge Function, whose secret lives in
# Supabase function secrets (see supabase/functions/.env.example and
# docs/ai-providers.md) — never in the app build.

# Optional. Public https URL of the hosted web app (e.g. your GitHub Pages
# URL). Used as the link when users share recipes/plans from the app, since
# the app's own address (https://localhost) is meaningless to recipients.
PUBLIC_URL=

# ----------------------------------------------------------------------------
# Android release signing — set as ENVIRONMENT VARIABLES (or GitHub Secrets),
# never in a committed file. Read by android/app/build.gradle.
# ----------------------------------------------------------------------------
# ANDROID_KEYSTORE_PATH=/absolute/path/to/upload-keystore.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=upload
# ANDROID_KEY_PASSWORD=
# ANDROID_VERSION_CODE=   # optional override of version.json's versionCode (CI)
